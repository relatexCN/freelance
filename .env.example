# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Key for this gateway (clients use this to authenticate)
API_KEY=sk-freelance-key
# Optionally configure multiple allowed API keys separated by commas
API_KEYS=sk-freelance-key1,sk-freelance-key2

# Provider API Keys
# You can provide multiple keys separated by commas for pooling (e.g., sk-1,sk-2)

#https://ollama.com/v1
OLLAMA_API_KEY=

# https://openrouter.ai/
OPENROUTER_API_KEY=

# https://api.groq.com/openai/v1/responses 国内无效
GROQ_API_KEY=

# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# https://github.com/marketplace/models
GITHUB_TOKEN=

# https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# https://build.nvidia.com/
NVIDIA_API_KEY=

# https://console.mistral.ai/
MISTRAL_API_KEY=

# https://app.hyperbolic.xyz/
HYPERBOLIC_API_KEY=

# https://api.novita.ai/
NOVITA_API_KEY=

# https://app.nebius.ai/
